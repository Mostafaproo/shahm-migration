# Base URL of the tenant-management service the settings-gate plugin calls
# (app/plugins/01.settings.ts) — `${TENANT_BASE_DOMAIN}/profile/settings?domain=`.
TENANT_BASE_DOMAIN=https://tms.test.ouredu.net

# Overrides hostname-based tenant resolution in the settings-gate plugin —
# useful for local dev where the request host (localhost) doesn't match a
# real tenant subdomain.
SETTINGS_DOMAIN=qdrat.shahm-test.ouredu.net
